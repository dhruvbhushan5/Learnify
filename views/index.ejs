<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta http-equiv="X-UA-Compatible" content="IE=edge">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Home</title>
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css">
   <link rel="stylesheet" href="/css/style.css">  
</head>

<body>

<header class="header">
   <section class="flex">
      <a href="#" class="logo">
         <img src="/images/WhatsApp Image 2024-08-01 at 14.25.29_18772675.jpg" alt="Learnify Logo" height="90px">
      </a>

      <form action="search.html" method="post" class="search-form">
         <input type="text" name="search_box" required placeholder="Search courses..." maxlength="100">
         <button type="submit" class="fas fa-search"></button>
      </form>

      <div class="icons">
         <div id="menu-btn" class="fas fa-bars"></div>
         <div id="search-btn" class="fas fa-search"></div>
         <div id="user-btn" class="fas fa-user"></div>
      </div>
   </section>
</header>   

<div class="side-bar">
   <div class="profile">
      <% if (locals.user) { %>
         <img src="/images/pic-1.jpg" class="image" alt="">
         <h3 class="name"><%= user.email.split('@')[0] %></h3>
         <p class="role"><%= user.role %></p>
         <% if (user.role === 'tutor') { %>
            <a href="/tutor/upload" class="option-btn" style="margin-bottom: .5rem; display: block; text-align: center; font-size: 1.4rem;">Upload Course</a>
         <% } %>
         <a href="/auth/logout" class="delete-btn" style="margin-top: .5rem; display: block; text-align: center; font-size: 1.4rem;">logout</a>
      <% } else { %>
         <p style="font-size: 1.6rem; margin-bottom: 1rem; color: var(--light-color);">Please login</p>
         <div class="flex-btn">
            <a href="/login" class="option-btn" style="font-size: 1.4rem;">login</a>
            <a href="/register" class="option-btn" style="font-size: 1.4rem;">register</a>
         </div>
      <% } %>
   </div>

   <nav class="navbar">
      <a href="/home"><i class="fas fa-home"></i><span>Home</span></a>
      <a href="/about"><i class="fas fa-question"></i><span>About</span></a>
      <a href="/courses"><i class="fas fa-graduation-cap"></i><span>Courses</span></a>
      <a href="/buy-course"><i class="fas fa-cart-shopping"></i><span>Buy a Course</span></a>
      <a href="/teachers"><i class="fas fa-chalkboard-user"></i><span>Teachers</span></a>
      <a href="/contactus"><i class="fas fa-headset"></i><span>Contact Us</span></a>
   </nav>
</div>

<section class="home-grid">
   <h1 class="heading">Quick Options</h1>
   <div class="box-container">
      <div class="box">
         <h3 class="title">Likes and Comments</h3>
         <p class="likes">Total Likes: <span>25</span></p>
         <a href="#" class="inline-btn">View Likes</a>
         <p class="likes">Total Comments: <span>12</span></p>
         <a href="#" class="inline-btn">View Comments</a>
         <p class="likes">Saved Playlists: <span>4</span></p>
         <a href="#" class="inline-btn">View Playlists</a>
      </div>
      <div class="box">
        <h3 class="title">top categories</h3>
        <div class="flex">
           <a href="#"><i class="fas fa-code"></i><span>development</span></a>
           <a href="#"><i class="fas fa-chart-simple"></i><span>business</span></a>
           <a href="#"><i class="fas fa-pen"></i><span>design</span></a>
           <a href="#"><i class="fas fa-chart-line"></i><span>marketing</span></a>
          
           <a href="#"><i class="fas fa-cog"></i><span>software</span></a>
           <a href="#"><i class="fas fa-vial"></i><span>science</span></a>
        </div>
     </div>

     <div class="box">
        <h3 class="title">popular topics</h3>
        <div class="flex">
           <a href="#" target="_blank"><i class="fab fa-html5"></i><span>HTML</span></a>
           <a href="#"><i class="fab fa-css3"></i><span>CSS</span></a>
           <a href="#"><i class="fab fa-js"></i><span>javascript</span></a>
           <a href="#"><i class="fab fa-react"></i><span>react</span></a>
           <a href="#"><i class="fab fa-php"></i><span>PHP</span></a>
           <a href="#"><i class="fab fa-bootstrap"></i><span>bootstrap</span></a>
        </div>
     </div>

     <div class="box">
        <h3 class="title">become a tutor</h3>
        <p class="tutor">Applying to become a tutor offers a unique opportunity to make a meaningful impact on students' lives while enhancing your own skills and experience. </p>
        <a href="/teacher_register" class="inline-btn">get started</a>
     </div>

  </div>

   </div>
</section>

<section class="courses">

    <h1 class="heading">Our Courses</h1>
 
    <div class="box-container">
       <% if (locals.courses && courses.length > 0) { %>
          <% courses.forEach(course => { %>
             <div class="box">
                <div class="tutor">
                   <img src="<%= course.tutorImage %>" alt="">
                   <div class="info">
                      <h3><%= course.tutorName %></h3>
                      <span><%= course.level %> course</span>
                   </div>
                </div>
                <div class="thumb"> 
                   <img src="<%= course.thumbnail %>" alt="<%= course.title %>">
                   <span><%= course.duration %></span>
                </div>
                <h3 class="title"><%= course.title %></h3>
                <div style="font-size: 1.6rem; margin-bottom: 1.5rem; font-weight: bold; color: var(--black);">
                   <% if (course.price > 0) { %>
                      Price: Rs. <%= course.price %>
                   <% } else { %>
                      Free
                   <% } %>
                </div>
                <% if (course.price > 0) { %>
                   <a href="/buy-course/<%= course.slug %>" class="inline-btn">Buy Course</a>
                <% } else { %>
                   <a href="/playlist/<%= course.slug %>" class="inline-btn">View Playlist</a>
                <% } %>
             </div>
          <% }) %>
       <% } else { %>
          <p style="font-size: 1.6rem; color: var(--light-color); text-align: center; width: 100%;">No courses found.</p>
       <% } %>
    </div>
 
    <div class="more-btn">
       <a href="/courses" class="inline-option-btn">view all courses</a>
    </div>
 
 </section>
 
 
 <footer class="footer">
 
    &copy; copyright @ 2024 by <span>learnify</span> | all rights reserved!
 
 </footer>
 
 
    
 </body>
 </html>


