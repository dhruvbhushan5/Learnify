<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta http-equiv="X-UA-Compatible" content="IE=edge">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title><%= title %></title>
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css">
   <link rel="stylesheet" href="/css/style.css">
   <style>
      .tutor-upload {
         max-width: 92rem;
         margin: 0 auto;
      }
      .form-box {
         background-color: var(--white);
         border-radius: 1rem;
         padding: 2.5rem;
         box-shadow: var(--box-shadow);
      }
      .form-box .panel-title {
         font-size: 2.2rem;
         color: #2c3e50;
         text-transform: capitalize;
         margin-bottom: .5rem;
      }
      .form-box .panel-subtitle {
         font-size: 1.5rem;
         color: #888;
         line-height: 1.7;
         margin-bottom: 2rem;
      }
      .form-grid {
         display: grid;
         grid-template-columns: repeat(2, minmax(0, 1fr));
         gap: 1.5rem;
      }
      .form-group {
         margin-bottom: 1.5rem;
      }
      .form-group label {
         font-size: 1.6rem;
         color: var(--black);
         display: block;
         margin-bottom: .8rem;
         font-weight: 600;
      }
      .form-group input, .form-group select, .form-group textarea {
         width: 100%;
         border-radius: 1rem;
         padding: 1.2rem;
         border: var(--border);
         background-color: #eee;
         font-size: 1.6rem;
         color: var(--black);
      }
      .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
         border-color: hsl(170, 75%, 41%);
         background-color: #fff;
      }
      .form-group textarea {
         resize: vertical;
         min-height: 12rem;
      }
      .full-width {
         grid-column: 1 / -1;
      }
      .section-title {
         display: flex;
         align-items: center;
         gap: 1rem;
         font-size: 2rem;
         color: #2c3e50;
         margin: 2.5rem 0 1.5rem;
         padding-bottom: 1rem;
         border-bottom: var(--border);
      }
      .section-title i {
         color: hsl(170, 75%, 41%);
      }
      .video-entry {
         border: var(--border);
         padding: 1.8rem;
         border-radius: 1rem;
         margin-bottom: 1.5rem;
         background-color: #f7f7f7;
      }
      .video-entry h4 {
         font-size: 1.7rem;
         color: #2c3e50;
         margin-bottom: 1.2rem;
         display: flex;
         align-items: center;
         gap: .8rem;
      }
      .video-entry h4 i {
         color: hsl(170, 75%, 41%);
      }
      .btn-add {
         background-color: #f39c12;
         color: var(--white);
         cursor: pointer;
         padding: 1rem 1.8rem;
         border-radius: .5rem;
         font-size: 1.6rem;
         display: inline-block;
         margin-bottom: 2rem;
         border: none;
         text-transform: capitalize;
      }
      .btn-add:hover {
         background-color: #2c3e50;
      }
      .alert-error {
         background-color: #f8d7da;
         color: #721c24;
         padding: 1.2rem;
         border-radius: .5rem;
         font-size: 1.6rem;
         margin-bottom: 2rem;
      }
      .alert-success {
         background-color: #d4edda;
         color: #155724;
         padding: 1.2rem;
         border-radius: .5rem;
         font-size: 1.6rem;
         margin-bottom: 2rem;
      }
      @media (max-width: 768px) {
         .form-grid {
            grid-template-columns: 1fr;
         }
         .form-box {
            padding: 2rem;
         }
      }
   </style>
</head>
<body>

<header class="header">
   <section class="flex">
      <a href="/home" class="logo"><img src="/images/WhatsApp Image 2024-08-01 at 14.25.29_18772675.jpg" alt="Learnify Logo" height="90px"></a>
      <div class="icons">
         <div id="menu-btn" class="fas fa-bars"></div>
         <div id="search-btn" class="fas fa-search"></div>
         <div id="user-btn" class="fas fa-user"></div>
      </div>
   </section>
</header>

<div class="side-bar">
   <div class="profile">
      <% if (locals.user) { %>
         <img src="/images/pic-1.jpg" class="image" alt="">
         <h3 class="name"><%= user.email.split('@')[0] %></h3>
         <p class="role"><%= user.role %></p>
         <a href="#" class="btn">view profile</a>
         <a href="/auth/logout" class="delete-btn" style="margin-top: 1rem; display: block; text-align: center;">logout</a>
      <% } else { %>
         <p style="font-size: 1.6rem; margin-bottom: 1rem;">Please login</p>
         <a href="/login" class="option-btn">login</a>
      <% } %>
   </div>

   <nav class="navbar">
      <a href="/home"><i class="fas fa-home"></i><span>Home</span></a>
      <a href="/about"><i class="fas fa-question"></i><span>About</span></a>
      <a href="/courses"><i class="fas fa-graduation-cap"></i><span>Courses</span></a>
      <a href="/buy-course"><i class="fas fa-cart-shopping"></i><span>Buy a Course</span></a>
      <a href="/teachers"><i class="fas fa-chalkboard-user"></i><span>Teachers</span></a>
      <a href="/contactus"><i class="fas fa-headset"></i><span>Contact Us</span></a>
   </nav>
</div>

<section class="courses tutor-upload">
   <h1 class="heading">Tutor Panel</h1>

   <div class="form-box">
      <h2 class="panel-title">Create New Course</h2>
      <p class="panel-subtitle">Add the course details, pricing, and video lessons students will see on Learnify.</p>

      <% if (error) { %>
         <div class="alert-error"><%= error %></div>
      <% } %>
      <% if (success) { %>
         <div class="alert-success"><%= success %></div>
      <% } %>

      <form action="/tutor/upload-course" method="post">
         <div class="form-grid">
            <div class="form-group">
               <label for="title">Course Title</label>
               <input type="text" id="title" name="title" placeholder="e.g. Complete HTML5 Course" required>
            </div>

            <div class="form-group">
               <label for="slug">URL Slug</label>
               <input type="text" id="slug" name="slug" placeholder="e.g. html5-mastery" required>
            </div>

            <div class="form-group">
               <label for="shortName">Display Name</label>
               <input type="text" id="shortName" name="shortName" placeholder="e.g. HTML5" required>
            </div>

            <div class="form-group">
               <label for="price">Price in INR</label>
               <input type="number" id="price" name="price" placeholder="e.g. 499" min="0" required>
            </div>

            <div class="form-group">
               <label for="level">Difficulty Level</label>
               <select id="level" name="level" required>
                  <option value="Beginner">Beginner</option>
                  <option value="Intermediate">Intermediate</option>
                  <option value="Advanced">Advanced</option>
               </select>
            </div>

            <div class="form-group full-width">
               <label for="description">Course Description</label>
               <textarea id="description" name="description" placeholder="Provide a summary of what students will learn..." required></textarea>
            </div>
         </div>

         <h3 class="section-title"><i class="fas fa-video"></i>Course Videos</h3>
         <div id="videos-container">
            <div class="video-entry">
               <h4><i class="fas fa-play-circle"></i>Video #1</h4>
               <div class="form-grid">
                  <div class="form-group">
                     <label>Video Title</label>
                     <input type="text" name="videoTitle" placeholder="e.g. Introduction to HTML" required>
                  </div>
                  <div class="form-group">
                     <label>Video URL</label>
                     <input type="url" name="videoUrl" placeholder="https://www.youtube.com/embed/..." required>
                  </div>
               </div>
            </div>
         </div>

         <button type="button" class="btn-add" id="add-video-btn"><i class="fas fa-plus"></i> Add Another Video</button>

         <button type="submit" class="btn" style="width: 100%; display: block; margin-top: 1rem;">Publish Course</button>
      </form>
   </div>
</section>

<footer class="footer">
   &copy; copyright @ 2024 by <span>learnify</span> | all rights reserved!
</footer>

<script>
   let videoCount = 1;
   const container = document.getElementById('videos-container');
   const addBtn = document.getElementById('add-video-btn');

   addBtn.addEventListener('click', () => {
      videoCount++;
      const entry = document.createElement('div');
      entry.className = 'video-entry';
      entry.innerHTML = `
         <h4><i class="fas fa-play-circle"></i>Video #${videoCount}</h4>
         <div class="form-grid">
            <div class="form-group">
               <label>Video Title</label>
               <input type="text" name="videoTitle" placeholder="Video Title" required>
            </div>
            <div class="form-group">
               <label>Video URL</label>
               <input type="url" name="videoUrl" placeholder="Video Embed URL" required>
            </div>
         </div>
      `;
      container.appendChild(entry);
   });
</script>

</body>
</html>
