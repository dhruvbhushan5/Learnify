<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta http-equiv="X-UA-Compatible" content="IE=edge">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>courses</title>
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css">


   <link rel="stylesheet" href="css/style.css">

</head>
<body>

    <header class="header">
   
        <section class="flex">
     
           <a href="#" class="logo"><img src="images/WhatsApp Image 2024-08-01 at 14.25.29_18772675.jpg" alt="" height="90px"></a>
     
           <form action="search.html" method="post" class="search-form">
              <input type="text" name="search_box" required placeholder="search courses..." maxlength="100">
              <button type="submit" class="fas fa-search"></button>
           </form>
     
           <div class="icons">
              <div id="menu-btn" class="fas fa-bars"></div>
              <div id="search-btn" class="fas fa-search"></div>
              <div id="user-btn" class="fas fa-user"></div>
          
           </div>
     
           
        </section>
     
     </header>   
     
     <div class="side-bar">
     
     
        <div class="profile">
           <% if (locals.user) { %>
              <img src="/images/pic-1.jpg" class="image" alt="">
              <h3 class="name"><%= user.email.split('@')[0] %></h3>
              <p class="role"><%= user.role %></p>
              <% if (user.role === 'tutor') { %>
                 <a href="/tutor/upload" class="option-btn" style="margin-bottom: .5rem; display: block; text-align: center; font-size: 1.4rem;">Upload Course</a>
              <% } %>
              <a href="/auth/logout" class="delete-btn" style="margin-top: .5rem; display: block; text-align: center; font-size: 1.4rem;">logout</a>
           <% } else { %>
              <p style="font-size: 1.6rem; margin-bottom: 1rem; color: var(--light-color);">Please login</p>
              <div class="flex-btn">
                 <a href="/login" class="option-btn" style="font-size: 1.4rem;">login</a>
                 <a href="/register" class="option-btn" style="font-size: 1.4rem;">register</a>
              </div>
           <% } %>
        </div>
     
        <nav class="navbar">
         <a href="/home"><i class="fas fa-home"></i><span>Home</span></a>
         <a href="/about"><i class="fas fa-question"></i><span>About</span></a>
         <a href="/courses"><i class="fas fa-graduation-cap"></i><span>Courses</span></a>
         <a href="/buy-course"><i class="fas fa-cart-shopping"></i><span>Buy a Course</span></a>
         <a href="/teachers"><i class="fas fa-chalkboard-user"></i><span>Teachers</span></a>
         <a href="/contactus"><i class="fas fa-headset"></i><span>Contact Us</span></a>
      </nav>
      
   
   
     </div>

<section class="courses">

   <h1 class="heading">our courses</h1>

   <div class="box-container">
      <% if (locals.courses && courses.length > 0) { %>
         <% courses.forEach(course => { %>
            <div class="box">
               <div class="tutor">
                  <img src="<%= course.tutorImage %>" alt="">
                  <div class="info">
                     <h3><%= course.tutorName %></h3>
                     <span><%= course.level %> course</span>
                  </div>
               </div>
               <div class="thumb">
                  <img src="<%= course.thumbnail %>" alt="<%= course.title %>">
                  <span><%= course.duration %></span>
               </div>
               <h3 class="title"><%= course.title %></h3>
               <div style="font-size: 1.6rem; margin-bottom: 1.5rem; font-weight: bold; color: var(--black);">
                  <% if (course.price > 0) { %>
                     Price: Rs. <%= course.price %>
                  <% } else { %>
                     Free
                  <% } %>
               </div>
               <% if (course.price > 0) { %>
                  <a href="/buy-course/<%= course.slug %>" class="inline-btn">buy course</a>
               <% } else { %>
                  <a href="/playlist/<%= course.slug %>" class="inline-btn">view playlist</a>
               <% } %>
            </div>
         <% }) %>
      <% } else { %>
         <p style="font-size: 1.6rem; color: var(--light-color); text-align: center; width: 100%;">No courses found.</p>
      <% } %>
   </div>

</section>
<footer class="footer">

    &copy; copyright @ 2024 by <span>learnify</span> | all rights reserved!
 
 </footer>
 



   
</body>
</html>
