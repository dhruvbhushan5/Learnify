<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= course.title %> - Playlist</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--light-bg);
      color: var(--black);
    }

    .playlist-container {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 0 2rem;
    }

    .course-details {
      background: var(--white);
      border-radius: .5rem;
      padding: 2rem;
      box-shadow: var(--box-shadow);
      margin-bottom: 3rem;
      display: flex;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .course-details .thumb {
      flex: 1 1 30rem;
      position: relative;
    }

    .course-details .thumb img {
      width: 100%;
      border-radius: .5rem;
      object-fit: cover;
      height: 20rem;
    }

    .course-details .info {
      flex: 1 1 50rem;
    }

    .course-details .info h2 {
      font-size: 2.5rem;
      color: var(--black);
      margin-bottom: 1rem;
    }

    .course-details .info p {
      font-size: 1.6rem;
      color: var(--light-color);
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .course-details .tutor-info {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .course-details .tutor-info img {
      width: 5rem;
      height: 5rem;
      border-radius: 50%;
    }

    .course-details .tutor-info h4 {
      font-size: 1.6rem;
      color: var(--black);
    }

    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(35rem, 1fr));
      gap: 2.5rem;
      margin-bottom: 4rem;
    }

    .video-card {
      background: var(--white);
      border-radius: .5rem;
      box-shadow: var(--box-shadow);
      padding: 2rem;
    }

    .video-card h3 {
      font-size: 1.8rem;
      color: var(--black);
      margin-bottom: 1.5rem;
    }

    .video-card iframe {
      width: 100%;
      height: 22rem;
      border-radius: .5rem;
    }

    .video-card video {
      width: 100%;
      height: 22rem;
      border-radius: .5rem;
      background: #000;
    }

    /* Comments Section CSS */
    .comments-section {
      background: var(--white);
      border-radius: .5rem;
      padding: 2rem;
      box-shadow: var(--box-shadow);
    }

    .comments-section h2 {
      font-size: 2.2rem;
      color: var(--black);
      margin-bottom: 2rem;
    }

    .comment-form textarea {
      width: 100%;
      border-radius: .5rem;
      padding: 1.5rem;
      font-size: 1.6rem;
      color: var(--black);
      background: var(--light-bg);
      border: var(--border);
      resize: vertical;
      height: 10rem;
      margin-bottom: 1.5rem;
    }

    .comment-list {
      margin-top: 3rem;
    }

    .comment-box {
      border-bottom: var(--border);
      padding: 1.5rem 0;
    }

    .comment-box:last-child {
      border-bottom: none;
    }

    .comment-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: .8rem;
    }

    .comment-user {
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--main-color);
    }

    .comment-date {
      font-size: 1.3rem;
      color: var(--light-color);
    }

    .comment-content {
      font-size: 1.6rem;
      color: var(--black);
      line-height: 1.4;
    }
  </style>
</head>
<body>

<header class="header">
   <section class="flex">
      <a href="/home" class="logo"><img src="/images/WhatsApp Image 2024-08-01 at 14.25.29_18772675.jpg" alt="Learnify Logo" height="90px"></a>
      <div class="icons">
         <div id="menu-btn" class="fas fa-bars"></div>
         <div id="search-btn" class="fas fa-search"></div>
         <div id="user-btn" class="fas fa-user"></div>
      </div>
   </section>
</header>

<div class="side-bar">
   <div class="profile">
      <% if (locals.user) { %>
         <img src="/images/pic-1.jpg" class="image" alt="">
         <h3 class="name"><%= user.email.split('@')[0] %></h3>
         <p class="role"><%= user.role %></p>
         <% if (user.role === 'tutor') { %>
            <a href="/tutor/upload" class="option-btn" style="margin-bottom: .5rem; display: block; text-align: center; font-size: 1.4rem;">Upload Course</a>
         <% } %>
         <a href="/auth/logout" class="delete-btn" style="margin-top: .5rem; display: block; text-align: center; font-size: 1.4rem;">logout</a>
      <% } else { %>
         <p style="font-size: 1.6rem; margin-bottom: 1rem; color: var(--light-color);">Please login</p>
         <div class="flex-btn">
            <a href="/login" class="option-btn" style="font-size: 1.4rem;">login</a>
            <a href="/register" class="option-btn" style="font-size: 1.4rem;">register</a>
         </div>
      <% } %>
   </div>

   <nav class="navbar">
      <a href="/home"><i class="fas fa-home"></i><span>Home</span></a>
      <a href="/about"><i class="fas fa-question"></i><span>About</span></a>
      <a href="/courses"><i class="fas fa-graduation-cap"></i><span>Courses</span></a>
      <a href="/buy-course"><i class="fas fa-cart-shopping"></i><span>Buy a Course</span></a>
      <a href="/teachers"><i class="fas fa-chalkboard-user"></i><span>Teachers</span></a>
      <a href="/contactus"><i class="fas fa-headset"></i><span>Contact Us</span></a>
   </nav>
</div>

<div class="playlist-container">
  
  <div class="course-details">
    <div class="thumb">
      <img src="<%= course.thumbnail %>" alt="<%= course.title %>">
    </div>
    <div class="info">
      <h2><%= course.title %></h2>
      <div class="tutor-info">
        <img src="<%= course.tutorImage %>" alt="">
        <div>
          <h4><%= course.tutorName %></h4>
          <span style="font-size:1.3rem; color:var(--light-color);"><%= course.level %> Level</span>
        </div>
      </div>
      <p><%= course.description %></p>
    </div>
  </div>

  <h2 style="font-size: 2.2rem; color: var(--black); margin-bottom: 2rem;">Course Videos (<%= videos.length %>)</h2>

  <% if (videos && videos.length > 0) { %>
    <div class="video-grid">
      <% videos.forEach((video, index) => { %>
        <div class="video-card">
          <h3><%= index + 1 %>. <%= video.title %></h3>
          <% if (/\.(mp4|webm|ogg)(\?.*)?$/i.test(video.videoUrl)) { %>
            <video controls src="<%= video.videoUrl %>"></video>
          <% } else { %>
            <iframe src="<%= video.videoUrl %>" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <p style="font-size: 1.6rem; color: var(--light-color); margin-bottom: 4rem;">No videos available in this course.</p>
  <% } %>

  <!-- Comments Section -->
  <div class="comments-section">
    <h2>Discussion Thread</h2>
    
    <form class="comment-form" action="/playlist/<%= course.slug %>/comment" method="POST">
      <textarea name="content" placeholder="Ask a question or leave a comment on this course..." required></textarea>
      <button type="submit" class="btn">Post Comment</button>
    </form>

    <div class="comment-list">
      <% if (locals.comments && comments.length > 0) { %>
        <% comments.forEach(comment => { %>
          <div class="comment-box">
            <div class="comment-header">
              <span class="comment-user"><%= comment.userEmail.split('@')[0] %></span>
              <span class="comment-date"><%= new Date(comment.createdAt).toLocaleDateString() %> <%= new Date(comment.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
            </div>
            <div class="comment-content"><%= comment.content %></div>
          </div>
        <% }) %>
      <% } else { %>
         <p style="font-size: 1.6rem; color: var(--light-color); text-align: center; padding: 2rem 0;">No comments yet. Start the conversation!</p>
      <% } %>
    </div>
  </div>

</div>

<footer class="footer">
   &copy; copyright @ 2024 by <span>learnify</span> | all rights reserved!
</footer>

</body>
</html>
