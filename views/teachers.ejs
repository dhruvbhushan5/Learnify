<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta http-equiv="X-UA-Compatible" content="IE=edge">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>teachers</title>

   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css">
   <link rel="stylesheet" href="/css/style.css">
</head>
<body>

   <header class="header">
      <section class="flex">
         <a href="#" class="logo"><img src="images/WhatsApp Image 2024-08-01 at 14.25.29_18772675.jpg" alt="" height="90px"></a>

         <form action="search.html" method="post" class="search-form">
            <input type="text" name="search_box" required placeholder="search courses..." maxlength="100">
            <button type="submit" class="fas fa-search"></button>
         </form>

         <div class="icons">
            <div id="menu-btn" class="fas fa-bars"></div>
            <div id="search-btn" class="fas fa-search"></div>
            <div id="user-btn" class="fas fa-user"></div>
         </div>
      </section>
   </header>   

   <div class="side-bar">
      <div class="profile">
         <img src="images/pic-1.jpg" class="image" alt="">
         <h3 class="name">Dhruv</h3>
         <p class="role">student</p>
         <a href="#" class="btn">view profile</a>
      </div>
      <nav class="navbar">
         <a href="/home"><i class="fas fa-home"></i><span>Home</span></a>
         <a href="/about"><i class="fas fa-question"></i><span>About</span></a>
         <a href="/courses"><i class="fas fa-graduation-cap"></i><span>Courses</span></a>
         <a href="/buy-course"><i class="fas fa-cart-shopping"></i><span>Buy a Course</span></a>
         <a href="/teachers"><i class="fas fa-chalkboard-user"></i><span>Teachers</span></a>
         <a href="/contactus"><i class="fas fa-headset"></i><span>Contact Us</span></a>
      </nav>
      
   
   </div>

   <section class="teachers">
      <h1 class="heading">Expert Teachers</h1>

      <form action="" method="post" class="search-tutor">
         <input type="text" name="search_box" placeholder="search tutors..." required maxlength="100">
         <button type="submit" class="fas fa-search" name="search_tutor"></button>
      </form>

      <div class="box-container">

         <div class="box offer">
            <h3>Become a Tutor</h3>
            <p>Applying to become a tutor offers a unique opportunity to make a meaningful impact on students' lives while enhancing your own skills and experience. </p>
            <a href="/teacher_register" class="inline-btn">get started</a>
         </div>

         <!-- Repeat for each tutor -->
         <div class="box">
            <div class="tutor">
               <img src="images/pic-2.jpg" alt="">
               <div>
                  <h3>Tapalagna Chakraborty</h3>
                  <span>Developer</span>
               </div>
            </div>
            <p>total playlists : <span>4</span></p>
            <p>total videos : <span>18</span></p>
            <p>total likes : <span>1208</span></p>
            <a href="teacher1_profile.html" class="inline-btn">view profile</a>
         </div>

         <div class="box">
            <div class="tutor">
               <img src="images/pic-1.jpg" alt="">
               <div>
                  <h3>Jatin Arora</h3>
                  <span>Professor</span>
               </div>
            </div>
            <p>total playlists : <span>4</span></p>
            <p>total videos : <span>18</span></p>
            <p>total likes : <span>1208</span></p>
            <a href="teacher2_profile.html" class="inline-btn">view profile</a>
         </div>

         <!-- Multiple hardcoded John Deo cards preserved -->
         <% for (let i = 0; i < 7; i++) { %>
         <div class="box">
            <div class="tutor">
               <img src="images/pic-2.jpg" alt="">
               <div>
                  <h3>john deo</h3>
                  <span>developer</span>
               </div>
            </div>
            <p>total playlists : <span>4</span></p>
            <p>total videos : <span>18</span></p>
            <p>total likes : <span>1208</span></p>
            <a href="#" class="inline-btn">view profile</a>
         </div>
         <% } %>

      </div>
   </section>

   <footer class="footer">
      &copy; copyright @ 2024 by <span>learnify</span> | all rights reserved!
   </footer>

</body>
</html>
