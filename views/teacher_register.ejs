<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta http-equiv="X-UA-Compatible" content="IE=edge">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Register as Tutor</title>
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css">
   <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header class="header">
   <section class="flex">
      <a href="/home" class="logo"><img src="/images/WhatsApp Image 2024-08-01 at 14.25.29_18772675.jpg" alt="Learnify Logo" height="90px"></a>
      <div class="icons">
         <div id="menu-btn" class="fas fa-bars"></div>
         <div id="search-btn" class="fas fa-search"></div>
         <div id="user-btn" class="fas fa-user"></div>
      </div>
   </section>
</header>   

<div class="side-bar">
   <div class="profile">
      <% if (locals.user) { %>
         <img src="/images/pic-1.jpg" class="image" alt="">
         <h3 class="name"><%= user.email.split('@')[0] %></h3>
         <p class="role"><%= user.role %></p>
         <% if (user.role === 'tutor') { %>
            <a href="/tutor/upload" class="option-btn" style="margin-bottom: .5rem; display: block; text-align: center; font-size: 1.4rem;">Upload Course</a>
         <% } %>
         <a href="/auth/logout" class="delete-btn" style="margin-top: .5rem; display: block; text-align: center; font-size: 1.4rem;">logout</a>
      <% } else { %>
         <p style="font-size: 1.6rem; margin-bottom: 1rem; color: var(--light-color);">Please login</p>
         <div class="flex-btn">
            <a href="/login" class="option-btn" style="font-size: 1.4rem;">login</a>
            <a href="/register" class="option-btn" style="font-size: 1.4rem;">register</a>
         </div>
      <% } %>
   </div>

   <nav class="navbar">
      <a href="/home"><i class="fas fa-home"></i><span>Home</span></a>
      <a href="/about"><i class="fas fa-question"></i><span>About</span></a>
      <a href="/courses"><i class="fas fa-graduation-cap"></i><span>Courses</span></a>
      <a href="/buy-course"><i class="fas fa-cart-shopping"></i><span>Buy a Course</span></a>
      <a href="/teachers"><i class="fas fa-chalkboard-user"></i><span>Teachers</span></a>
      <a href="/contactus"><i class="fas fa-headset"></i><span>Contact Us</span></a>
   </nav>
</div>

<section class="form-container">
   <form action="/auth/teacher_register" method="post">
      <h3>Tutor Registration</h3>
      <% if (typeof message !== 'undefined') { %>
          <p style="font-size: 1.6rem; color: <%= type === 'error' ? 'red' : 'green' %>; margin-bottom: 1.5rem;"><%= message %></p>
      <% } %>
      <p>Your Name</p>
      <input type="text" name="name" placeholder="enter your name" required maxlength="50" class="box">
      <p>Your Email</p>
      <input type="email" name="email" placeholder="enter your email" required maxlength="50" class="box">
      <p>Your Password</p>
      <input type="password" name="pass" placeholder="enter your password" required maxlength="20" class="box">
      <p>Confirm Password</p>
      <input type="password" name="c_pass" placeholder="confirm your password" required maxlength="20" class="box">
      <input type="submit" value="Register Now" name="submit" class="btn">
   </form>
</section>

<footer class="footer">
    &copy; copyright @ 2024 by <span>learnify</span> | all rights reserved!
</footer>

</body>
</html>
